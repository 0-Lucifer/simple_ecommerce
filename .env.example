# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Project Settings > API (KEEP SECRET).
# Server-only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Store branding
NEXT_PUBLIC_SITE_NAME="Candle Co."

# Currency + locale used to format prices (ISO codes)
NEXT_PUBLIC_CURRENCY="BDT"
NEXT_PUBLIC_LOCALE="en-BD"

# WhatsApp number for orders — international format, digits only, NO + or spaces
# Example: 8801712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
